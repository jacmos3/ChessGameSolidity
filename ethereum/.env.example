# Copy this file to ethereum/.env. Never commit the populated file.
# Use a dedicated deployment wallet; do not reuse a wallet holding valuable assets.
MNEMONIC=

# Prefer an authenticated provider. Public endpoints can be rate-limited.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Protocol allocation and operations wallets.
TEAM_WALLET=
TREASURY_WALLET=
FAUCET_SIGNER=
ORACLE_UPDATER=

# Make the Base Sepolia ownership decision explicit. Base mainnet always hands
# administration to the timelock regardless of this value.
GOVERNANCE_HANDOFF=true
