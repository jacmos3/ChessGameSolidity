# Copy this file to ethereum/.env. Never commit the populated file.
# Use a dedicated deployment wallet; do not reuse a wallet holding valuable assets.
MNEMONIC=

# Prefer an authenticated provider. Public endpoints can be rate-limited.
BASE_SEPOLIA_RPC_URL=
# Prevent Truffle's 2.5 gwei EIP-1559 fallback from overpaying on Base.
BASE_MAX_PRIORITY_FEE_PER_GAS_WEI=1000000
# Defaults to the absolute 5 gwei safety ceiling. A lower positive value reduces
# the deployer's required up-front balance; preflight rejects current fees or its
# conservative 100-million-gas full-migration budget when the value is insufficient.
BASE_MAX_FEE_PER_GAS_WEI=5000000000

# Protocol allocation and operations wallets. With governance handoff enabled,
# TREASURY_WALLET must differ from the deployer when governance handoff is enabled.
TEAM_WALLET=
TREASURY_WALLET=
# May be an EOA or an ERC-1271 contract wallet.
FAUCET_SIGNER=
ORACLE_UPDATER=

# Make the experimental Base Sepolia ownership decision explicit.
GOVERNANCE_HANDOFF=true

# After migration, copy the SHA-256 printed for the exact deployment manifest.
# Public `verify:deployment` runs fail closed without this independent anchor.
DEPLOYMENT_MANIFEST_SHA256=
